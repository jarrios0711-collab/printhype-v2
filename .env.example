# PrintHype v2 — Environment Variables
# ======================================
# Copia este archivo como .env y completá los valores.
# NUNCA subas claves reales a Git. Estas son SOLO plantillas.

# Supabase (público — safe para frontend)
# Creá un proyecto en https://supabase.com y copiá estos valores desde
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Supabase Service Role (SOLO server-side — NUNCA exponer, NUNCA commitear)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# MercadoPago (billing)
# Credenciales desde https://www.mercadopago.com.ar/developers
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=tu-secret-de-webhook
NEXT_PUBLIC_APP_URL=http://localhost:3000
