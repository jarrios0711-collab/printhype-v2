# PrintHype v2 — Environment Variables
# =======================================
# Copia este archivo como .env y completá los valores

# Supabase (público — safe para frontend)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-pública

# Supabase Service Role (SOLO server-side — NUNCA exponer)
# Lo seteas en Vercel Dashboard > Environment Variables
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
